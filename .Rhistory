testeo_75_na <- generar_datos_faltantes(df=testeo, columnas=columnas_predictoras, porcentaje=0.75)
validacion_75_na <- generar_datos_faltantes(df=validacion, columnas=columnas_predictoras, porcentaje=0.75)
